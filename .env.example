# Local native MySQL. init provisions 127.0.0.1:3307 without containers.
# Placeholder credentials are replaced with a generated password for a managed instance.
# Production uses an existing MySQL database; never enable local provisioning there.
APP_NAME="HK Hub API"
VERSION=0.1.0
ENVIRONMENT=local
API_PREFIX=/api
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL="mysql+pymysql://hkhub:change_me@127.0.0.1:3307/hkhub?charset=utf8mb4"
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
LOCAL_DATABASE_AUTOSTART=true
# MYSQLD_BIN=/absolute/path/to/mysqld
# LOCAL_DATABASE_ADMIN_URL=mysql+pymysql://admin:password@127.0.0.1:3307/
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
UPSTREAM_TIMEOUT_SECONDS=15
