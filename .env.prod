# Public production configuration. This file is committed to Git.
# Shell-compatible syntax: quote values containing spaces or JSON.
# Never put passwords, private keys, tokens or DATABASE_URL here.
# GitHub Actions Secrets required: SERVER_SSH_KEY, DATABASE_URL, POSTGRES_PASSWORD.
# DATABASE_URL: postgresql+psycopg2://hkhub:<encoded-app-password>@postgres:5432/hkhub
# POSTGRES_PASSWORD is a separate admin password used only by the database container.
# Configure DEEPSEEK_API_KEY in GitHub Secrets to enable the education tool.

# Deployment target: SSH uses port 22; paste a verified server public host key.
SERVER_HOST=1.12.73.100
SERVER_USER=ubuntu
# Verifies the server's identity; this is NOT your private login key.
SERVER_SSH_KNOWN_HOSTS='1.12.73.100 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOY6YsHeX3YEpJLj/MNSOrz+lvUoSt3zs+6ID4mFvRss'
# API binds only to 127.0.0.1 on the host. Choose a port unused by other projects.
API_HOST_PORT=8000
SERVER_IMAGE_NAME=hkhub-server

# API runtime (independent of local .env).
APP_NAME='HK Hub API'
VERSION=0.1.0
ENVIRONMENT=production
API_PREFIX=/api
DEBUG=false
LOG_LEVEL=INFO
# Native mobile clients do not require CORS. Add actual web origins if needed.
CORS_ORIGINS='[]'
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
UPSTREAM_TIMEOUT_SECONDS=15
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=150

# Company source collection; API and worker make no AI calls.
COMPANY_OBSERVATION_ENABLED=true
COMPANY_OBSERVATION_POLL_SECONDS=86400
COMPANY_OBSERVATION_SOURCE_TIMEOUT_SECONDS=120
COMPANY_OBSERVATION_MAX_DOWNLOAD_BYTES=8388608
COMPANY_OBSERVATION_MAX_SOURCE_ROWS=30000
COMPANY_OBSERVATION_BATCH_SIZE=100
