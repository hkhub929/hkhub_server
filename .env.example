# Native local PostgreSQL starts only with ./cmd.sh db:up (127.0.0.1:5433).
# db:up creates the local database and replaces placeholder credentials with a generated password.
# init and API commands never start a database; external databases are managed separately.
APP_NAME="HK Hub API"
VERSION=0.1.0
ENVIRONMENT=local
API_PREFIX=/api
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL="postgresql+psycopg2://hkhub:change_me@127.0.0.1:5433/hkhub"
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# POSTGRES_BIN_DIR=/absolute/path/to/postgresql/bin
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
UPSTREAM_TIMEOUT_SECONDS=15
# Cross-border commute sampling. Only the collector process writes observations.
COMMUTE_COLLECT_INTERVAL_MINUTES=15
COMMUTE_HISTORY_DAYS=7
COMMUTE_RETENTION_DAYS=30
COMMUTE_STALE_AFTER_MINUTES=30
