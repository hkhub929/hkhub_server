# Configuration reference: public variables + GitHub Actions Secrets.
# Copy to .env for LOCAL development; the API reads .env, not this example.
# Production public values belong in the committed .env.prod, not GitHub Variables.
# Production secrets belong in GitHub, never in .env.prod or committed files.
# Do not replace .env.prod with this file: runtime defaults below are LOCAL.

# ============================================================================
# Part 1: Public environment variables (no passwords, private keys or tokens)
# ============================================================================

# Deployment only: edit these values in .env.prod for production CI/CD.
# The local API ignores these deployment settings.
SERVER_HOST=your-server-host
SERVER_USER=your-server-user
# Deployment SSH uses the standard port 22; no port configuration is needed.
# Paste a verified known_hosts entry to verify the server's identity.
# This is the server's PUBLIC host key, not your private login key.
SERVER_SSH_KNOWN_HOSTS=''
# Host API port; the production container itself always listens on 8000.
# Nginx must proxy to the same host port. This does not change the local API port.
API_HOST_PORT=8000
SERVER_IMAGE_NAME=hkhub-server

# API runtime: local defaults below; production values are in .env.prod.
APP_NAME='HK Hub API'
VERSION=0.1.0
ENVIRONMENT=local
# Production requires ENVIRONMENT=production and DEBUG=false.
API_PREFIX=/api
DEBUG=false
LOG_LEVEL=INFO
# Production native mobile clients use CORS_ORIGINS='[]'.
CORS_ORIGINS='["http://localhost:8080","http://127.0.0.1:8080"]'
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
UPSTREAM_TIMEOUT_SECONDS=15
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=150

# Company observation: separate worker, read-only API without AI calls.
COMPANY_OBSERVATION_ENABLED=true
COMPANY_OBSERVATION_POLL_SECONDS=86400
COMPANY_OBSERVATION_SOURCE_TIMEOUT_SECONDS=120
COMPANY_OBSERVATION_MAX_DOWNLOAD_BYTES=8388608
COMPANY_OBSERVATION_MAX_SOURCE_ROWS=30000
COMPANY_OBSERVATION_BATCH_SIZE=100

# Local only: set this if native PostgreSQL executables are not on PATH.
# POSTGRES_BIN_DIR=/absolute/path/to/postgresql/bin

# ============================================================================
# Part 2: Secrets (real values must NEVER be committed)
# ============================================================================
# GitHub locations (either scope works with the current production workflow):
# - Settings > Environments > production > Environment secrets
# - Settings > Secrets and variables > Actions > Repository secrets
# Use the exact secret names below. No GitHub Variables are currently required.

# SERVER_SSH_KEY [required for production deployment]
# Value: the full private key CONTENT, including BEGIN/END lines and newlines.
# Do not enter a file path. It must authenticate SERVER_USER on SERVER_HOST.
# CI/CD reads this only from GitHub Secrets; do not put it in the local .env.
SERVER_SSH_KEY=''

# DATABASE_URL [required for production deployment and local database access]
# Local: ./cmd.sh db:up explicitly starts native PostgreSQL on 127.0.0.1:5433,
# creates the local database and replaces placeholder credentials below.
# init/API commands never start a database. External databases are managed separately.
DATABASE_URL='postgresql+psycopg2://hkhub:change_me@127.0.0.1:5433/hkhub'
# Production GitHub Secret: use the fixed service, user and database below.
# postgresql+psycopg2://hkhub:<URL-encoded-app-password>@postgres:5432/hkhub
# The first deployment creates the hkhub login/database inside PostgreSQL's container.
# Containers share a Compose network; no host port or host pg_hba.conf changes needed.
# URL-encode reserved password characters. Never copy the local URL to production.
# This app password must differ from POSTGRES_PASSWORD (the administrator password).
# Existing app passwords are NOT changed by deployment; rotate them separately.

# POSTGRES_PASSWORD [required for production PostgreSQL initialization]
# Configure a separate strong administrator password in GitHub Secrets only.
# Used only by the postgres container, never injected into the API or worker.
# Set once for the persistent data directory. Changing it does not rotate the DB
# password; the deployment refuses changed initialization settings until reviewed.
POSTGRES_PASSWORD=''

# DEEPSEEK_API_KEY [required for education analysis; optional for deployment]
# Local: fill only in the ignored .env. Production: configure in GitHub Secrets.
# Empty is allowed, but /api/education/analyse then returns an unconfigured error.
DEEPSEEK_API_KEY=''

# Deployment generates /srv/data/hkhub/prod/server/api/server.env from .env.prod
# and GitHub DATABASE_URL/DEEPSEEK_API_KEY. PostgreSQL's separate runtime config is
# /srv/data/hkhub/prod/shared/postgresql/postgres.env (POSTGRES_PASSWORD).
# Database data is /srv/data/hkhub/prod/shared/postgresql/data, not in a release.
# First deployment: select apply_migrations to create application tables.
# Never commit runtime files or run compose down -v. Back up the database separately.
# Host-installed PostgreSQL data is not migrated automatically; confirm/backup it
# before stopping that old instance after the container deployment is validated.
